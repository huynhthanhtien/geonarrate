APP_ENV=dev
DATABASE_URL=postgresql+asyncpg://geonarrate:geonarrate@localhost:5432/geonarrate_dev
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-dev-only
STORAGE_DIR=./var/storage
TTS_PROVIDER=edge
MAGPIE_TTS_URL=http://127.0.0.1:18081
MAGPIE_TTS_VOICE=Aria
MAGPIE_TTS_AUTOSTART=true
MAGPIE_TTS_DEVICE=cpu
# Dịch qua Groq: TRANSLATE_PROVIDER=groq và đặt GROQ_API_KEY (khóa chỉ ở backend)
# Model mặc định: openai/gpt-oss-20b; xem danh sách model được Groq hỗ trợ.
TRANSLATE_PROVIDER=mock
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Dịch thật: TRANSLATE_PROVIDER=libretranslate (instance phải có đủ các cặp ngôn ngữ)
LIBRETRANSLATE_URL=http://127.0.0.1:5000
LIBRETRANSLATE_API_KEY=
CORS_ORIGINS=["http://localhost:5173"]
PUBLIC_RATE_LIMIT=300
PUBLIC_ACTIVATE_RATE_LIMIT=10
PUBLIC_RATE_WINDOW_S=60
# Tuỳ chọn: cài .[quality] và cấu hình model ASR đã được cấp quyền tải.
# Để rỗng = không chấm; không sinh điểm giả.
WHISPER_MODEL=
# Chỉ dev: seed 1 admin khi khởi động (bỏ trống thì không seed)
DEV_ADMIN_EMAIL=admin@geonarrate.test
DEV_ADMIN_PASSWORD=admin12345
