{
  "expo": {
    "name": "GeoNarrate",
    "slug": "geonarrate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.geonarrate.mobile"
    },
    "android": {
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4F1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.geonarrate.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "GeoNarrate dùng vị trí để tự phát thuyết minh khi bạn đến gần một điểm.",
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "GeoNarrate dùng camera để quét mã QR trên vé.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "recordAudioAndroid": false
        }
      ],
      "@maplibre/maplibre-react-native",
      "./plugins/android-map-network",
      "./plugins/android-dev-network",
      "./plugins/android-release-signing",
      "expo-font"
    ],
    "scheme": "geonarrate"
  }
}
